# ---------------------------------------------------------------------
# Serving the application from the folder above public/
# ---------------------------------------------------------------------
# The application expects the document root to point at public/. Where
# that cannot be changed — and on plenty of shared hosting it cannot —
# the site answers at /public and not at /, which is what this fixes:
# every request is handed into public/, and the .htaccess already there
# does the rest of the routing.
#
# Pointing the document root at public/ is still the better arrangement,
# because it puts app/, config/ and storage/ physically outside the folder
# Apache serves, where no misconfiguration can reach them. This file is
# the next best thing, and the deny rules below are the reason it is safe
# enough to use.
#
# NOTE: this file belongs to the repository layout only. The flat package
# built by build-cpanel.php has index.php at the top and no public/ at
# all, and writes its own .htaccess — do not copy this one into it.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Certificate renewal. AutoSSL and Let's Encrypt both prove ownership
    # by fetching a file from here, and handing that into public/ — where
    # it is not — makes the check fail and the certificate quietly expire.
    RewriteRule ^\.well-known/ - [L]

    # The maintenance pages live beside this file rather than inside
    # public/, so the catch-all below would look for them in the wrong
    # place and the router would answer 404. upgrade.php is how pending
    # database changes get applied after a deployment; hiding it is how a
    # deployment ends up looking like it did nothing.
    RewriteRule ^(upgrade|check)\.php$ - [L]

    # Anything already inside public/ is left exactly as it is — the
    # .htaccess in there handles real files and the front controller.
    RewriteRule ^public/ - [L]

    # Everything else is handed to it. Relative, with no reference to the
    # document root, so this works whether the application sits at the
    # root of a domain or in a folder beneath one.
    RewriteRule ^(.*)$ public/$1 [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
# The folders that must never be served
# ---------------------------------------------------------------------
# Each of these already carries its own .htaccess saying the same thing.
# It is repeated here deliberately: with the document root above public/,
# these folders sit inside the tree Apache serves, and one missing file
# would put the database password on the open web. Two independent rules
# now have to fail before that can happen.
#
# Verified against Apache 2.4 in exactly that layout: with the per-folder
# files deleted these rules still refused every one of them, and with
# these removed as well, database/seed.sql served in full.
RedirectMatch 404 ^(.*)/(app|config|database|storage|tests|deploy)(/|$)

# The working files of the project itself are nobody's business either.
RedirectMatch 404 ^(.*)/\.(git|github|env)(/|$)
RedirectMatch 404 ^(.*)/(composer\.(json|lock)|package(-lock)?\.json|\.cpanel\.yml)$

# migrate.php and cron.php refuse to run over the web on their own, but
# there is no reason for them to be reachable at all.
RedirectMatch 404 ^(.*)/(migrate|cron|build-cpanel)\.php$

# ---------------------------------------------------------------------
# The PHP files that sit beside this one
# ---------------------------------------------------------------------
# <Files> matches the file Apache finally settles on, so it holds whatever
# the rewrites above did or did not do — which is why the two that must
# never run over the web are named here rather than left to a rewrite.
#
# routes.php is a fragment, not a page: run on its own it fails partway
# through and the error names paths on the server.
<Files "routes.php">
    Require all denied
</Files>

<Files "dev-server.php">
    Require all denied
</Files>

# check.php reports the document root, the PHP build and the folder
# permissions. That is exactly what you want when a deployment has gone
# wrong, and exactly what an attacker wants the rest of the time, so it
# is shut by default.
#
# TO USE IT: comment out the three lines below, load
# https://your-domain/check.php, then put them back.
<Files "check.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
