# ---------------------------------------------------------------------
# Serving the application from the folder above public/
# ---------------------------------------------------------------------
# The application expects the document root to point at public/. Where
# that cannot be changed — and on plenty of shared hosting it cannot —
# the site answers at /public and not at /, which is what this fixes:
# every request is handed into public/, and the .htaccess already there
# does the rest of the routing.
#
# Pointing the document root at public/ is still the better arrangement,
# because it puts app/, config/ and storage/ physically outside the folder
# Apache serves, where no misconfiguration can reach them. This file is
# the next best thing, and the deny rules below are the reason it is safe
# enough to use.
#
# NOTE: this file belongs to the repository layout only. The flat package
# built by build-cpanel.php has index.php at the top and no public/ at
# all, and writes its own .htaccess — do not copy this one into it.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Certificate renewal. AutoSSL and Let's Encrypt both prove ownership
    # by fetching a file from here, and handing that into public/ — where
    # it is not — makes the check fail and the certificate quietly expire.
    RewriteRule ^\.well-known/ - [L]

    # The maintenance pages live beside this file rather than inside
    # public/, so the catch-all below would look for them in the wrong
    # place and the router would answer 404. upgrade.php is how pending
    # database changes get applied after a deployment; hiding it is how a
    # deployment ends up looking like it did nothing.
    RewriteRule ^(upgrade|check)\.php$ - [L]

    # -----------------------------------------------------------------
    # The marketing site sits in front of the system
    # -----------------------------------------------------------------
    # site/ is the company website, kept as its own application with its
    # own database. It owns the front door and every path that really
    # exists inside it; the system owns everything else.
    #
    # The site used to run a client portal and an admin of its own. Both
    # are gone: two client portals meant two passwords and two places a
    # customer's invoices could disagree, and two admins meant every
    # price and phone number lived in both. The system's are the ones
    # that remain.
    #
    # These redirects are for everybody holding a bookmark or an old
    # email pointing at the ones that went. Without them a customer
    # following "View my portal" would land on a 404 and conclude we had
    # lost their account.
    RewriteRule ^client(/.*)?$ /portal/login [R=301,L]
    RewriteRule ^admin(/.*)?$  /login        [R=301,L]
    #
    # One origin can only have one service worker at the root, and a
    # worker registered at / controls the whole origin — including the
    # system's pages. The two ship different ones, so this names the
    # winner rather than leaving it to whichever file Apache reaches
    # first. The system's is network-first for pages and
    # stale-while-revalidate for assets; the website's was cache-first on
    # everything under /assets/, which would have gone on serving the
    # system's old stylesheet for as long as the cache lived.
    RewriteRule ^sw\.js$ public/index.php [QSA,L]

    # The site answers at the front door, not at its folder name. Asked
    # for by folder from outside, it is sent to the real address so one
    # page does not answer at two URLs.
    #
    # REDIRECT_STATUS is what tells the two apart: it is empty on a
    # request that arrived this way, and set once mod_rewrite has already
    # pointed something here. Without it the internal rewrite below would
    # bounce straight back out to the browser.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^site/(.*)$ /$1 [R=301,L]

    # Anything already pointed into site/ is finished with. In .htaccess
    # context [L] only ends the current pass — mod_rewrite runs the whole
    # set again over the rewritten path — so without this, site/index.php
    # comes back round, matches nothing, and is handed to the system as
    # public/site/index.php. It answered 301 rather than the home page,
    # which is what a rewrite loop looks like from outside.
    RewriteRule ^site/ - [L]

    # Crawlers look for /sitemap.xml by convention, and the site's was a
    # static file that went stale the moment a page was added. It is
    # generated now, so the conventional address answers with the
    # generated one rather than with nothing.
    RewriteRule ^sitemap\.xml$ site/sitemap.php [L]

    # The front door.
    RewriteRule ^$ site/index.php [L]

    # Anything that is really a file or a folder in site/ belongs to the
    # website: its pages, its assets, its admin and client areas, its
    # API. Tested with -f and -d rather than listed, so nothing has to be
    # added here when the site gains a page.
    #
    # This is also what keeps /assets/ from being a collision: both
    # applications serve from that prefix, and whichever one actually has
    # the file answers for it.
    RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI} -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/site%{REQUEST_URI} -d
    RewriteRule ^(.+)$ site/$1 [L]

    # Anything already inside public/ is left exactly as it is — the
    # .htaccess in there handles real files and the front controller.
    RewriteRule ^public/ - [L]

    # Everything else is handed to it. Relative, with no reference to the
    # document root, so this works whether the application sits at the
    # root of a domain or in a folder beneath one.
    RewriteRule ^(.*)$ public/$1 [QSA,L]
</IfModule>

# ---------------------------------------------------------------------
# The folders that must never be served
# ---------------------------------------------------------------------
# Each of these already carries its own .htaccess saying the same thing.
# It is repeated here deliberately: with the document root above public/,
# these folders sit inside the tree Apache serves, and one missing file
# would put the database password on the open web. Two independent rules
# now have to fail before that can happen.
#
# Verified against Apache 2.4 in exactly that layout: with the per-folder
# files deleted these rules still refused every one of them, and with
# these removed as well, database/seed.sql served in full.
RedirectMatch 404 ^(.*)/(app|config|database|storage|tests|deploy)(/|$)

# The working files of the project itself are nobody's business either.
RedirectMatch 404 ^(.*)/\.(git|github|env)(/|$)
RedirectMatch 404 ^(.*)/(composer\.(json|lock)|package(-lock)?\.json|\.cpanel\.yml)$

# migrate.php and cron.php refuse to run over the web on their own, but
# there is no reason for them to be reachable at all.
RedirectMatch 404 ^(.*)/(migrate|cron|build-cpanel)\.php$

# ---------------------------------------------------------------------
# The website's own working files
# ---------------------------------------------------------------------
# The site was written to sit at a document root of its own, where these
# were still reachable and nobody had noticed. Serving it from here puts
# them one URL away, so they are named.
#
# includes/ holds db_connect.php, which carries the database password.
# database.sql and seed.sql are the schema and its seed data. models.json
# describes every table. The rest are build and deployment tooling that
# has no business answering a request.
RedirectMatch 404 ^(.*)/(includes|migrations)(/|$)
RedirectMatch 404 ^(.*)/[^/]+\.(sql|py|ps1|md|lock)$
RedirectMatch 404 ^(.*)/(models|package|package-lock|vite\.config)\.(json|js)$
RedirectMatch 404 ^(.*)/(migrate_users|debug)\.php$

# ---------------------------------------------------------------------
# The PHP files that sit beside this one
# ---------------------------------------------------------------------
# <Files> matches the file Apache finally settles on, so it holds whatever
# the rewrites above did or did not do — which is why the two that must
# never run over the web are named here rather than left to a rewrite.
#
# routes.php is a fragment, not a page: run on its own it fails partway
# through and the error names paths on the server.
<Files "routes.php">
    Require all denied
</Files>

<Files "dev-server.php">
    Require all denied
</Files>

# check.php reports the document root, the PHP build and the folder
# permissions. That is exactly what you want when a deployment has gone
# wrong, and exactly what an attacker wants the rest of the time, so it
# is shut by default.
#
# TO USE IT: comment out the three lines below, load
# https://your-domain/check.php, then put them back.
<Files "check.php">
    Require all denied
</Files>

<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
