# =====================================================================
# The website's own settings
# =====================================================================
# Copy this to .env beside it and fill it in. The real file is never
# committed — it carries the database password.
#
# The website keeps its own database, separate from the system's. That is
# deliberate: the two are separate applications that happen to share a
# domain, and the site's admin, blog and client area were built against
# this schema. Nothing here is read by the system, and nothing in
# config/config.php is read by the site.
#
# Without a .env the site falls back to localhost / shanfix_tech / root
# with no password, which is right for a developer's machine and wrong
# everywhere else.
# =====================================================================

DB_HOST=localhost
DB_PORT=3306

# On cPanel this is prefixed with the account name, e.g. shanfix_tech
# becomes cpaneluser_shanfixtech. Copy it exactly as cPanel shows it.
DB_NAME=shanfix_tech
DB_USER=
DB_PASS=

# Leave this false on a live server. Turned on, a failed database
# connection prints the reason — which includes the host and the user —
# straight onto the page.
DEBUG=false

# =====================================================================
# Where this site answers
# =====================================================================
# The one address the site names itself by: canonical links, Open Graph
# images, the structured data every page carries, and the Sitemap line
# in robots.txt. Every one of those has to be absolute, and the domain
# used to be written out in thirty-one files.
#
# No trailing slash. Include the scheme. Leave it unset and the live
# domain is assumed, which is right in production and is also why a
# staging copy MUST set it — otherwise the staging pages tell Google
# they are duplicates of the live ones and ask to be dropped.
SITE_URL=https://shanfixtechnology.com

# The company's phone number, e-mail address and postal address are NOT
# here. They come from the system's Settings, so that the number on a
# printed invoice and the number in the footer of this site cannot
# disagree. Change them in the system, under Settings.
