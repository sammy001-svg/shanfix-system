# Holds the database password and the encryption key — never commit.
/config/config.php

# Auto-generated encryption key — losing it makes stored secrets unreadable.
/storage/app.key

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build output — regenerate any time with:  php build-cpanel.php
# deploy/ is a full copy of the application, so committing it doubles the
# repository and makes every diff unreadable.
/deploy/
/quick-fix/
/shanfix-cpanel.zip
*.zip

# Local dumps
*.sql.gz
*.bak

# Cookie jars and captured output the suites leave behind.
/tests/*.txt
/tests/*.eml

# Scratch pages used to measure or seed the browser while testing. They
# are served from public/, so one left behind is one more thing on the
# open web that nobody meant to publish.
public/_*.html

# ---------------------------------------------------------------------
# The company website that sits in front of the system
# ---------------------------------------------------------------------
# Its own application with its own database, so its own credentials.
# site/.env is where they live on a real server; the example beside it
# says what belongs in it.
/site/.env
/site/.env.*
!/site/.env.example

# uploads/ is deliberately NOT ignored. It is data rather than code and
# would normally be left out, but the site references what is in there
# and a fresh deployment with an empty folder is a page with a missing
# image on it. Worth revisiting if it ever grows past a handful.

# Build tooling the site does not use at runtime — its CSS is committed
# already — and a virtualenv that has no business here.
/site/node_modules/
/site/dist/
/site/.venv/
/site/__pycache__/

# ---------------------------------------------------------------------
# What a test run leaves behind
# ---------------------------------------------------------------------
# The suites write cookie jars and a captured mail queue beside
# themselves. They are the leavings of a run, not part of it, and one of
# them turned up in a commit's worth of changes waiting to be staged.
/tests/*.txt
/tests/queue.eml*
/tests/*.log
