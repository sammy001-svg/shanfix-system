# Holds the database password and the encryption key — never commit.
/config/config.php

# Auto-generated encryption key — losing it makes stored secrets unreadable.
/storage/app.key

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build output — regenerate any time with:  php build-cpanel.php
# deploy/ is a full copy of the application, so committing it doubles the
# repository and makes every diff unreadable.
/deploy/
/quick-fix/
/shanfix-cpanel.zip
*.zip

# Local dumps
*.sql.gz
*.bak
