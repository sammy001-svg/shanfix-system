# Holds the database password and the encryption key — never commit.
/config/config.php

# Auto-generated encryption key — losing it makes stored secrets unreadable.
/storage/app.key

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local dumps
*.sql.gz
*.bak
